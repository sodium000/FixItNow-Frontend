# Copy to .env.local for local development.
# On Vercel: Project → Settings → Environment Variables → add each key below.

# Copy to .env.local for local development.
# On Vercel: Project → Settings → Environment Variables → add each key below.

# Backend API (required)
# Must be your deployed backend URL, NOT localhost
# Example: https://fixitnow-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# Image upload on registration (optional)
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key

# API backend URL
NEXT_PUBLIC_API_URL=https://your-backend.example.com

# JWT secrets used only on the server (do not expose these publicly)
JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret
